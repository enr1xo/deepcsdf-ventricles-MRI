{
    "Description": "...",

    "TrainSplit": "train/data_fnames_train.json",

    "TestSplit": "test/data_fnames_test.json",

    "ValSplit": "val/data_fnames_val_5patients.json",

    "Network_specs": {
        "latent_size": 64,
        "out_dim": 3,
        "dims": [256,256,256,256,256],
        "latent_in": [1,3,5],
        "conditioning": "film",
        "positional_encoding": false,
        "pos_enc_dim": 4,
        "lipschitz_layers": [-1],
        "use_lipschitz_normalized_layers": true,
        "activation": "SiLU",
        "last_tanh": false,
        "norm_layers": [-1],
        "batch_norm": false,
        "dropout_prob": 0.2,
        "dropout_layers": [-1]
    },

    "NumEpochs": 1000,
    "lr_weights": 0.001,
    "lr_latents": 0.005,
    "num_samp_per_scene": 4096,
    "sampling_scene_method": "random",
    "balance_pos_neg": true,
    "batch_size": 89,
    "scale_spatial_inputs_by": 100,
    "enforce_minmax": true,
    "clamp_distance": 0.1,
    "use_loss": "SmoothL1",
    "lipschitz_alpha": 1e-07,
    "code_reg_lambda": 1e-06,
    "anneal_reg_loss": true,
    "code_reg_anneal_warmup_epochs": 2500,
    "use_lr_scheduler": true,
    "lr_weights_final": 0.0001,
    "lr_latents_final": 0.0005,
    "lr_decay_time_max": 40000,

    "val_batch_size": 5,
    "NumEpochsFit": 500,
    "w_post": 1e-04,

    "log_every_n_epochs": 100,
    "log_val_every_n_epochs": 100,
    "checkpoint_every_n_epochs": 2000000,
    "resume_training_from_version": "-"
}