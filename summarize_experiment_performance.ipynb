   "source": [
    "table_chd = (\n",
    "    df_chd\n",
    "    .pivot_table(\n",
    "        index=[\"lambda_reg\", \"version\"],   # can accept multi-index rows [\"column label 1\", \"column label 2\"]\n",
    "        columns=\"organ\",\n",
    "        values=[\"mean\", \"std\"],\n",
    "        aggfunc=\"mean\"\n",
    "    )\n",
    "    .sort_index()\n",
    "    .swaplevel(axis=1)\n",
    "    .sort_index(axis=1)\n",
    ")\n",
    "\n",
    "table_hsd = (\n",
    "    df_hsd\n",
    "    .pivot_table(\n",
    "        index=\"lambda_reg\",   # can accept multi-index rows [\"column label 1\", \"column label 2\"]\n",
    "        columns=\"organ\",\n",
    "        values=[\"mean\", \"std\"],\n",
    "        aggfunc=\"mean\"\n",
    "    )\n",
    "    .sort_index()\n",
    "    .swaplevel(axis=1) # swaps organ and aggfunc, so instead of having \"mean\" and \"std\" as top level and then epi la ra for each, It's the other way around\n",
    "    .sort_index(axis=1)\n",
    ")"
   ]
  },
