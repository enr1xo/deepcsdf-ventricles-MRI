   "id": "76d8b84c",
   "metadata": {},
   "source": [
    "Compute mean and std over all patients for each version and for each organ"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 46,
   "id": "36118fcc",
   "metadata": {},
   "outputs": [],
   "source": [
    "df_chd = df_all_chd.groupby([\"organ\", \"version\", \"lambda_reg\"])[\"value_norm\"].agg( \n",
    "    mean=\"mean\",\n",
    "    std=\"std\"\n",
    ").reset_index()\n",
    "\n",
    "df_hsd = df_all_hsd.groupby([\"organ\", \"lambda_reg\"])[\"value_norm\"].agg( \n",
    "    mean=\"mean\",\n",
    "    std=\"std\"\n",
    ").reset_index()"
   ]
  },
